<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@null">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rate a Game"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Player Name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="16dp"
        android:textColorHint="#CCCCCC"
        app:boxStrokeColor="@color/lime"
        app:hintTextColor="@color/lime"
        app:boxBackgroundColor="@color/glass_input">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_player_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Game Name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="24dp"
        android:textColorHint="#CCCCCC"
        app:boxStrokeColor="@color/lime"
        app:hintTextColor="@color/lime"
        app:boxBackgroundColor="@color/glass_input">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_game_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Rating"
        android:textSize="16sp"
        android:textColor="#E2E8F0"
        android:layout_marginBottom="12dp"/>

    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1.0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        style="@android:style/Widget.Material.RatingBar"
        android:progressTint="@color/lime"
        android:isIndicator="false"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit_rate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SUBMIT RATING"
        app:cornerRadius="12dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:backgroundTint="@color/lime"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:indeterminateTint="@color/lime"/>

</LinearLayout>
